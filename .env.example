# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. (.env.local은 git에 커밋되지 않습니다)

# ── 서버 전용 (브라우저에 노출되지 않음) ──
# 서울 열린데이터광장 인증키 - 따릉이 실시간 대여정보
SEOUL_API_KEY=
# 공공데이터포털 인증키 - 기상청 초단기실황, 도로교통공단 자전거 사고다발지역
DATA_GO_KR_API_KEY=
# 카카오 REST API 키 - 장소 검색
KAKAO_REST_API_KEY=
# 서울시 OpenAPI는 HTTP 전용이라 명시적으로 허용해야 호출함 (true/false)
SEOUL_ALLOW_HTTP=true

# ── 브라우저 공개 (카카오 콘솔에서 허용 도메인으로 보호) ──
NEXT_PUBLIC_KAKAO_JS_KEY=
